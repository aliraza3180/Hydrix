{%- comment -%} HYDRIX — Subscribe & save band (blue-bordered) {%- endcomment -%}
{{ 'hydrix.css' | asset_url | stylesheet_tag }}

{%- liquid assign s = section.settings -%}

<section class="hx-section hx-sband" style="
  --hx-bg: {{ s.bg }};
  --hx-heading: {{ s.heading_color }};
  --hx-body: {{ s.body_color }};
  --hx-accent: {{ s.accent }};
  --hx-accent-hover: {{ s.accent_hover }};
  padding: {{ s.padding }}px 24px;
">
  {% render 'hydrix-bg', settings: section.settings %}
  <div class="hx-sband__panel scroll-trigger animate--slide-in" style="
    background: linear-gradient(120deg, {{ s.panel_from }}, {{ s.bg }} 70%);
    border: 1px solid {{ s.accent }};
  ">
    <div class="hx-sband__copy">
      <h2 class="hx-h2 hx-sband__h2">{{ s.heading }}</h2>
      {%- if s.body != blank -%}<p class="hx-sband__body" style="color:{{ s.body_color }}">{{ s.body }}</p>{%- endif -%}
    </div>
    <div class="hx-sband__cta">
      {%- if s.figure != blank -%}<div class="hx-sband__figure" style="color:{{ s.figure_color }}">{{ s.figure }}</div>{%- endif -%}
      <a href="{{ s.button_url }}" class="hx-btn" style="margin-top:16px">{{ s.button_label }}</a>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hx-sband__panel {
    max-width: 1000px; margin: 0 auto; border-radius: 20px; padding: clamp(30px,5vw,48px);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 30px; align-items: center;
    box-shadow: 0 0 60px rgba(45,107,255,.14);
  }
  #shopify-section-{{ section.id }} .hx-sband__h2 { font-size: clamp(26px,3.6vw,40px); }
  #shopify-section-{{ section.id }} .hx-sband__body { margin-top: 12px; font-size: 15.5px; line-height: 1.6; }
  #shopify-section-{{ section.id }} .hx-sband__cta { text-align: right; }
  #shopify-section-{{ section.id }} .hx-sband__figure { font-family: var(--hx-font-display); font-weight: 800; font-size: clamp(36px,6vw,56px); line-height: 1; }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX Subscribe Band",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never run dry." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Subscribe & save 15% on every order. Skip, swap, or cancel anytime." },
    { "type": "text", "id": "figure", "label": "Figure (e.g. 15% off)", "default": "15% off" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start a subscription" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 30, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "panel_from", "label": "Panel gradient", "default": "#0d1530" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body", "default": "#9AA5B3" },
    { "type": "color", "id": "figure_color", "label": "Figure", "default": "#8FD9FF" },
    { "type": "color", "id": "accent", "label": "Accent / border", "default": "#2D6BFF" },
    { "type": "color", "id": "accent_hover", "label": "Accent hover", "default": "#3B7EFF" }
  ],
  "presets": [{ "name": "HYDRIX Subscribe Band" }]
}
{% endschema %}
