{%- comment -%} HYDRIX — Product teaser (floating tub + spec pills). {%- endcomment -%}
{{ 'hydrix.css' | asset_url | stylesheet_tag }}

{%- liquid assign s = section.settings -%}

<section class="hx-section hx-teaser" style="
  --hx-bg: {{ s.bg }};
  --hx-heading: {{ s.heading_color }};
  --hx-accent: {{ s.accent }};
  --hx-border: {{ s.border }};
  padding: {{ s.padding }}px 24px;
">
  {% render 'hydrix-bg', settings: section.settings %}
  <div class="hx-teaser__beam"></div>
  <div class="hx-wrap hx-teaser__wrap scroll-trigger animate--slide-in">
    <div class="hx-teaser__float hx-floaty">
      <div class="hx-teaser__glow"></div>
      {%- if s.image != blank -%}
        <img src="{{ s.image | image_url: width: 880 }}" alt="{{ s.image.alt | default: s.heading }}" class="hx-teaser__img">
      {%- else -%}
        <img src="{{ 'daily-front.png' | asset_url }}" alt="{{ s.heading }}" class="hx-teaser__img">
      {%- endif -%}
      {%- for block in section.blocks -%}
        <span class="hx-pill hx-teaser__pill hx-teaser__pill--{{ forloop.index }}" style="--hx-border:{{ s.pill_bg }};--hx-glow:{{ s.pill_text }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
      {%- endfor -%}
    </div>
    {%- if s.heading != blank -%}<h2 class="hx-h2 hx-teaser__h2">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.button_label != blank -%}
      <a href="{{ s.button_url }}" class="hx-btn hx-btn--ghost" style="margin-top:24px">{{ s.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hx-teaser { position: relative; }
  #shopify-section-{{ section.id }} .hx-teaser__wrap { max-width: 1100px; margin-inline: auto; text-align: center; position: relative; }
  #shopify-section-{{ section.id }} .hx-teaser__beam {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 2px; height: 40%;
    background: linear-gradient(180deg, #8FD9FF, transparent); opacity: .5;
  }
  #shopify-section-{{ section.id }} .hx-teaser__float { position: relative; width: fit-content; margin: 0 auto; }
  #shopify-section-{{ section.id }} .hx-teaser__glow {
    position: absolute; inset: -8% -14%;
    background: radial-gradient(ellipse at center, rgba(45,107,255,.30), transparent 64%); filter: blur(28px);
  }
  #shopify-section-{{ section.id }} .hx-teaser__img { position: relative; width: min(440px, 78vw); border-radius: 18px; display: block; }
  #shopify-section-{{ section.id }} .hx-teaser__pill { position: absolute; white-space: nowrap; box-shadow: 0 8px 24px rgba(0,0,0,.4); font-size: 12.5px; padding: 8px 14px; }
  #shopify-section-{{ section.id }} .hx-teaser__pill--1 { top: 14%; left: -8%; }
  #shopify-section-{{ section.id }} .hx-teaser__pill--2 { top: 42%; right: -10%; }
  #shopify-section-{{ section.id }} .hx-teaser__pill--3 { bottom: 30%; left: -10%; }
  #shopify-section-{{ section.id }} .hx-teaser__pill--4 { bottom: 12%; right: -6%; }
  #shopify-section-{{ section.id }} .hx-teaser__h2 { margin-top: 40px; font-size: clamp(26px, 3.6vw, 40px); }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX Product Teaser",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet DAILY — Full-Spectrum Hydration System™" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See what's inside →" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 40, "max": 120, "step": 2, "unit": "px", "default": 90 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2D6BFF" },
    { "type": "color", "id": "border", "label": "Border", "default": "#20242A" },
    { "type": "color", "id": "pill_bg", "label": "Pill background", "default": "#20242A" },
    { "type": "color", "id": "pill_text", "label": "Pill text", "default": "#8FD9FF" }
  ],
  "blocks": [
    { "type": "pill", "name": "Spec pill", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "30 servings" } ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "HYDRIX Product Teaser", "blocks": [
    { "type": "pill", "settings": { "label": "30 servings" } },
    { "type": "pill", "settings": { "label": "Glacier Citrus" } },
    { "type": "pill", "settings": { "label": "Zero sugar" } },
    { "type": "pill", "settings": { "label": "Third-party tested" } }
  ]}]
}
{% endschema %}
