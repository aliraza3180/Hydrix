{{ 'hydrix.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hydrix.js' | asset_url }}" defer="defer"></script>
{%- comment -%} HYDRIX — Product (DAILY) buy box + supporting sections. PDP interactivity lives in hydrix.js (data-hx-pdp). {%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  if s.img_front != blank
    assign src_front = s.img_front | image_url: width: 1000
  else
    assign src_front = 'daily-front.png' | asset_url
  endif
  if s.img_back != blank
    assign src_back = s.img_back | image_url: width: 1000
  else
    assign src_back = 'daily-back.png' | asset_url
  endif
  if s.img_benefits != blank
    assign src_benefits = s.img_benefits | image_url: width: 1000
  else
    assign src_benefits = 'daily-benefits.png' | asset_url
  endif
  if s.img_lid != blank
    assign src_lid = s.img_lid | image_url: width: 1000
  else
    assign src_lid = 'daily-lid.png' | asset_url
  endif
-%}

{%- comment -%} Prices are plain decimal text settings (e.g. "41.65"); rendered verbatim with a $ prefix. JS recomputes totals from data-price. {%- endcomment -%}
{%- assign sub_total_str = s.sub_price -%}

<section class="hx-section hx-pdp" id="{{ s.anchor | default: 'pdp' }}" style="
  --hx-bg: {{ s.bg }};
  --hx-heading: {{ s.heading_color }};
  --hx-body: {{ s.body_color }};
  --hx-accent: {{ s.accent }};
  --hx-accent-hover: {{ s.accent_hover }};
  --hx-border: {{ s.border }};
  --hx-card-bg: {{ s.card_bg }};
  --hx-muted: {{ s.muted_color }};
  --hx-light-text: {{ s.light_text_color }};
  --hx-facts-bg: {{ s.facts_bg }};
  --hx-facts-ink: {{ s.facts_ink }};
  --hx-facts-rule: {{ s.facts_rule }};
">
  {% render 'hydrix-bg', settings: section.settings %}

  {%- comment -%} ================= BREADCRUMB ================= {%- endcomment -%}
  {%- if s.show_breadcrumb -%}
    <div class="hx-wrap hx-pdp__crumb">
      <a href="{{ s.crumb_url | default: '#' }}">{{ s.crumb_root }}</a> / <span>{{ s.crumb_current }}</span>
    </div>
  {%- endif -%}

  {%- comment -%} ================= 1. GALLERY + BUY BOX ================= {%- endcomment -%}
  <div class="hx-wrap hx-pdp__main" data-hx-pdp>
    {%- comment -%} GALLERY {%- endcomment -%}
    <div class="hx-pdp__gallery scroll-trigger animate--fade-in">
      <div class="hx-stage hx-pdp__stage">
        <div class="hx-glow-radial"></div>
        <img class="hx-pdp__main-img" data-hx-main src="{{ src_front }}" alt="{{ s.product_title }}">
      </div>
      <div class="hx-pdp__thumbs">
        <button class="hx-pdp__thumb is-active" data-hx-thumb data-src="{{ src_front }}" type="button" aria-label="{{ s.thumb1_alt }}"><img src="{{ src_front }}" alt="{{ s.thumb1_alt }}"></button>
        <button class="hx-pdp__thumb" data-hx-thumb data-src="{{ src_back }}" type="button" aria-label="{{ s.thumb2_alt }}"><img src="{{ src_back }}" alt="{{ s.thumb2_alt }}"></button>
        <button class="hx-pdp__thumb" data-hx-thumb data-src="{{ src_benefits }}" type="button" aria-label="{{ s.thumb3_alt }}"><img src="{{ src_benefits }}" alt="{{ s.thumb3_alt }}"></button>
        <button class="hx-pdp__thumb" data-hx-thumb data-src="{{ src_lid }}" type="button" aria-label="{{ s.thumb4_alt }}"><img src="{{ src_lid }}" alt="{{ s.thumb4_alt }}"></button>
      </div>
    </div>

    {%- comment -%} BUY BOX {%- endcomment -%}
    <div class="hx-pdp__buybox scroll-trigger animate--slide-in">
      <h1 class="hx-h1 hx-pdp__title">{{ s.product_title }}</h1>
      {%- if s.tagline != blank -%}<div class="hx-pdp__tagline">{{ s.tagline }}</div>{%- endif -%}

      <div class="hx-pdp__rating">
        <span class="hx-stars">{{ s.stars }}</span>
        <span class="hx-pdp__rating-meta">{{ s.rating_text }}</span>
      </div>

      <div class="hx-pdp__price-row">
        <span class="hx-pdp__price" data-hx-price>${{ sub_total_str }}</span>
        <span class="hx-pdp__price-unit">{{ s.price_unit }}</span>
      </div>

      {%- comment -%} FLAVOR PILLS {%- endcomment -%}
      <div class="hx-pdp__group">
        <div class="hx-pdp__label">{{ s.flavor_label }}</div>
        <div class="hx-pdp__flavors">
          {%- for block in section.blocks -%}
            {%- if block.type == 'flavor' -%}
              {%- assign is_first = false -%}
              {%- if forloop.first -%}{%- assign is_first = true -%}{%- endif -%}
              <button type="button" class="hx-chip{% if block.settings.default_active %} hx-chip--active{% endif %}{% if block.settings.disabled %} hx-pdp__flavor--soon{% endif %}" data-hx-flavor {{ block.shopify_attributes }}>{{ block.settings.name }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} PLAN SELECTOR {%- endcomment -%}
      <div class="hx-pdp__plans">
        {%- comment -%} Subscribe & Save (default active) {%- endcomment -%}
        <button type="button" class="hx-pdp__plan is-active" data-hx-plan data-price="{{ s.sub_price }}">
          <span class="hx-pdp__radio"><span class="hx-pdp__radio-dot"></span></span>
          <span class="hx-pdp__plan-body">
            <span class="hx-pdp__plan-top">
              <span class="hx-pdp__plan-name">{{ s.sub_name }}</span>
              <span class="hx-pdp__plan-price hx-pdp__plan-price--save">${{ sub_total_str }}</span>
            </span>
            <span class="hx-pdp__plan-sub">{{ s.sub_sub }}</span>
          </span>
          {%- if s.sub_badge != blank -%}<span class="hx-pdp__plan-badge">{{ s.sub_badge }}</span>{%- endif -%}
        </button>
        {%- comment -%} One-time {%- endcomment -%}
        <button type="button" class="hx-pdp__plan" data-hx-plan data-price="{{ s.one_price }}">
          <span class="hx-pdp__radio"><span class="hx-pdp__radio-dot"></span></span>
          <span class="hx-pdp__plan-body">
            <span class="hx-pdp__plan-top">
              <span class="hx-pdp__plan-name">{{ s.one_name }}</span>
              <span class="hx-pdp__plan-price">${{ s.one_price }}</span>
            </span>
            <span class="hx-pdp__plan-sub">{{ s.one_sub }}</span>
          </span>
        </button>
      </div>

      {%- comment -%} QTY + ADD TO CART {%- endcomment -%}
      <div class="hx-pdp__buy-row">
        <div class="hx-pdp__qty">
          <button type="button" class="hx-pdp__qty-btn" data-hx-dec aria-label="Decrease quantity">−</button>
          <span class="hx-pdp__qty-val" data-hx-qty>1</span>
          <button type="button" class="hx-pdp__qty-btn" data-hx-inc aria-label="Increase quantity">+</button>
        </div>
        <button type="button" class="hx-btn hx-pdp__atc">{{ s.atc_label }} — <span data-hx-btn-total>${{ sub_total_str }}</span></button>
      </div>

      {%- comment -%} TRUST ROW {%- endcomment -%}
      <div class="hx-pdp__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust' -%}
            <span class="hx-pdp__trust-item"><span class="hx-pdp__diamond">◆</span> {{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ================= 2. BENEFIT ICON ROW ================= {%- endcomment -%}
  {%- if s.show_benefits -%}
    <div class="hx-pdp__benefits scroll-trigger animate--slide-in">
      <div class="hx-wrap hx-pdp__benefits-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <div class="hx-pdp__benefit" {{ block.shopify_attributes }}>
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="{{ s.accent }}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                {%- case block.settings.icon -%}
                  {%- when 'droplet' -%}<path d="M12 3.5c3 4 5.5 6.7 5.5 10a5.5 5.5 0 0 1-11 0c0-3.3 2.5-6 5.5-10Z"/>
                  {%- when 'bolt' -%}<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>
                  {%- when 'brain' -%}<path d="M9 5a3 3 0 0 0-3 3 3 3 0 0 0-1 5.8A3 3 0 0 0 9 19V5Z"/><path d="M15 5a3 3 0 0 1 3 3 3 3 0 0 1 1 5.8A3 3 0 0 1 15 19V5Z"/>
                  {%- when 'hexagon' -%}<path d="m12 3 7 4v8l-7 4-7-4V7l7-4Z"/>
                  {%- when 'leaf' -%}<path d="M11 20c-5 0-8-3-8-9 6 0 9 1 9 9Z"/><path d="M11 20c0-7 4-12 10-13 0 7-3 13-10 13Z"/>
                  {%- when 'shield' -%}<path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6l-7-3Z"/>
                  {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
                  {%- else -%}<path d="M12 3.5c3 4 5.5 6.7 5.5 10a5.5 5.5 0 0 1-11 0c0-3.3 2.5-6 5.5-10Z"/>
                {%- endcase -%}
              </svg>
              <div class="hx-pdp__benefit-label">{{ block.settings.text }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= 3. WHY + SUPPLEMENT FACTS ================= {%- endcomment -%}
  <div class="hx-pdp__why-wrap">
    <div class="hx-wrap hx-pdp__why-grid scroll-trigger animate--slide-in">
      <div class="hx-pdp__why">
        {%- if s.why_eyebrow != blank -%}<div class="hx-eyebrow">{{ s.why_eyebrow }}</div>{%- endif -%}
        {%- if s.why_heading != blank -%}<h2 class="hx-h2 hx-pdp__why-h2">{{ s.why_heading }}</h2>{%- endif -%}
        {%- if s.why_body != blank -%}<p class="hx-lead hx-pdp__why-body">{{ s.why_body }}</p>{%- endif -%}
        <div class="hx-pdp__stats">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="hx-pdp__stat" {{ block.shopify_attributes }}>
                <div class="hx-pdp__stat-num">{{ block.settings.value }}</div>
                <div class="hx-pdp__stat-label">{{ block.settings.label }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} SUPPLEMENT FACTS — Soft White card {%- endcomment -%}
      <div class="hx-light-card hx-pdp__facts">
        <div class="hx-pdp__facts-title">{{ s.facts_title }}</div>
        <div class="hx-pdp__facts-serving">{{ s.facts_serving }}</div>
        <div class="hx-pdp__facts-dv">{{ s.facts_dv_label }}</div>
        <div class="hx-pdp__facts-rows">
          {%- for block in section.blocks -%}
            {%- if block.type == 'fact' -%}
              <div class="hx-pdp__fact-row{% if block.settings.indent %} hx-pdp__fact-row--indent{% endif %}{% if block.settings.heavy_rule %} hx-pdp__fact-row--heavy{% endif %}" {{ block.shopify_attributes }}>
                <span>{{ block.settings.name }}</span>
                <span>{{ block.settings.dv }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if s.facts_footnote != blank -%}<div class="hx-pdp__facts-foot">{{ s.facts_footnote }}</div>{%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ================= 4. HOW TO USE ================= {%- endcomment -%}
  {%- if s.show_howto -%}
    <div class="hx-pdp__howto scroll-trigger animate--slide-in">
      <div class="hx-wrap hx-pdp__howto-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="hx-pdp__step" {{ block.shopify_attributes }}>
              <div class="hx-pdp__step-num">{{ block.settings.number }}</div>
              <div class="hx-pdp__step-title">{{ block.settings.title }}</div>
              {%- if block.settings.desc != blank -%}<p class="hx-pdp__step-desc">{{ block.settings.desc }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= 6. RECOVER BUNDLE STRIP ================= {%- endcomment -%}
  {%- if s.show_bundle -%}
    <div class="hx-pdp__bundle-wrap">
      <div class="hx-wrap">
        <div class="hx-pdp__bundle scroll-trigger animate--fade-in">
          <div class="hx-pdp__bundle-copy">
            {%- if s.bundle_heading != blank -%}<h3 class="hx-h3 hx-pdp__bundle-h3">{{ s.bundle_heading }}</h3>{%- endif -%}
            {%- if s.bundle_body != blank -%}<p class="hx-pdp__bundle-body">{{ s.bundle_body }}</p>{%- endif -%}
          </div>
          {%- if s.bundle_btn_label != blank -%}<a href="{{ s.bundle_btn_url | default: '#' }}" class="hx-btn hx-pdp__bundle-btn">{{ s.bundle_btn_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= 7. PRODUCT FAQ ================= {%- endcomment -%}
  {%- if s.show_faq -%}
    <div class="hx-pdp__faq-wrap">
      <div class="hx-wrap--narrow hx-pdp__faq scroll-trigger animate--slide-in">
        {%- if s.faq_heading != blank -%}<h2 class="hx-h2 hx-pdp__faq-h2">{{ s.faq_heading }}</h2>{%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="hx-faq__item"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
              <summary class="hx-faq__q"><span>{{ block.settings.q }}</span><span class="hx-faq__toggle">+</span></summary>
              <div class="hx-faq__a">{{ block.settings.a }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= 8. STICKY MOBILE ADD-TO-CART ================= {%- endcomment -%}
  {%- if s.show_sticky -%}
    <div class="hx-pdp__sticky">
      <div class="hx-pdp__sticky-info">
        <div class="hx-pdp__sticky-total">${{ sub_total_str }}</div>
        <div class="hx-pdp__sticky-meta">{{ s.sticky_meta }}</div>
      </div>
      <button type="button" class="hx-btn hx-pdp__sticky-btn">{{ s.atc_label }}</button>
    </div>
  {%- endif -%}

</section>

{% style %}
  #shopify-section-{{ uid }} .hx-pdp { padding-bottom: {% if s.show_sticky %}96px{% else %}0{% endif %}; }
  #shopify-section-{{ uid }} .hx-pdp__crumb { padding-top: 22px; color: var(--hx-muted); font-size: 13px; }
  #shopify-section-{{ uid }} .hx-pdp__crumb a { color: var(--hx-muted); text-decoration: none; }
  #shopify-section-{{ uid }} .hx-pdp__crumb a:hover { color: var(--hx-heading); }
  #shopify-section-{{ uid }} .hx-pdp__crumb span { color: var(--hx-heading); }

  /* ---- Main grid ---- */
  #shopify-section-{{ uid }} .hx-pdp__main {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 48px; align-items: start; padding-top: 24px; padding-bottom: 60px;
  }
  #shopify-section-{{ uid }} .hx-pdp__gallery { position: sticky; top: 90px; }
  #shopify-section-{{ uid }} .hx-pdp__stage {
    border-radius: 18px; aspect-ratio: 1 / 1;
    display: flex; align-items: center; justify-content: center;
    background: radial-gradient(ellipse at center, rgba(45,107,255,.16), transparent 65%), var(--hx-near-black);
  }
  #shopify-section-{{ uid }} .hx-pdp__main-img { position: relative; z-index: 1; width: 86%; height: 86%; object-fit: contain; }
  #shopify-section-{{ uid }} .hx-pdp__thumbs { margin-top: 14px; display: flex; gap: 10px; flex-wrap: wrap; }
  #shopify-section-{{ uid }} .hx-pdp__thumb {
    width: 74px; height: 74px; border-radius: 11px; overflow: hidden; cursor: pointer;
    background: var(--hx-near-black); padding: 0; border: 1px solid var(--hx-border); transition: border-color .2s;
  }
  #shopify-section-{{ uid }} .hx-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ uid }} .hx-pdp__thumb.is-active { border-color: var(--hx-accent); }
  #shopify-section-{{ uid }} .hx-pdp__thumb:hover { border-color: var(--hx-accent); }

  /* ---- Buy box ---- */
  #shopify-section-{{ uid }} .hx-pdp__title { font-size: clamp(34px, 5vw, 54px); line-height: 1; }
  #shopify-section-{{ uid }} .hx-pdp__tagline { margin-top: 8px; color: var(--hx-accent); font-size: 15px; font-weight: 500; }
  #shopify-section-{{ uid }} .hx-pdp__rating { margin-top: 14px; display: flex; align-items: center; gap: 10px; }
  #shopify-section-{{ uid }} .hx-pdp__rating .hx-stars { font-size: 13px; letter-spacing: 1px; }
  #shopify-section-{{ uid }} .hx-pdp__rating-meta { color: var(--hx-muted); font-size: 13px; }
  #shopify-section-{{ uid }} .hx-pdp__price-row { margin-top: 18px; display: flex; align-items: baseline; gap: 8px; }
  #shopify-section-{{ uid }} .hx-pdp__price { font-family: var(--hx-font-display); font-weight: 700; font-size: 34px; color: var(--hx-heading); }
  #shopify-section-{{ uid }} .hx-pdp__price-unit { color: var(--hx-muted); font-size: 15px; font-weight: 400; }

  #shopify-section-{{ uid }} .hx-pdp__group { margin-top: 26px; }
  #shopify-section-{{ uid }} .hx-pdp__label { color: var(--hx-muted); font-size: 13px; margin-bottom: 10px; }
  #shopify-section-{{ uid }} .hx-pdp__flavors { display: flex; gap: 10px; flex-wrap: wrap; }
  #shopify-section-{{ uid }} .hx-pdp__flavor--soon { opacity: .6; }

  /* ---- Plans ---- */
  #shopify-section-{{ uid }} .hx-pdp__plans { margin-top: 26px; display: flex; flex-direction: column; gap: 12px; }
  #shopify-section-{{ uid }} .hx-pdp__plan {
    cursor: pointer; text-align: left; background: transparent;
    border: 1px solid var(--hx-border); border-radius: 14px; padding: 18px 20px;
    display: flex; align-items: center; gap: 14px; transition: border-color .2s, background .2s; width: 100%;
  }
  #shopify-section-{{ uid }} .hx-pdp__plan.is-active { background: rgba(45,107,255,.07); border-color: var(--hx-accent); }
  #shopify-section-{{ uid }} .hx-pdp__radio {
    width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--hx-muted);
    flex: 0 0 auto; display: flex; align-items: center; justify-content: center; transition: border-color .2s;
  }
  #shopify-section-{{ uid }} .hx-pdp__plan.is-active .hx-pdp__radio { border-color: var(--hx-accent); }
  #shopify-section-{{ uid }} .hx-pdp__radio-dot { width: 9px; height: 9px; border-radius: 50%; background: transparent; transition: background .2s; }
  #shopify-section-{{ uid }} .hx-pdp__plan.is-active .hx-pdp__radio-dot { background: var(--hx-accent); }
  #shopify-section-{{ uid }} .hx-pdp__plan-body { flex: 1; }
  #shopify-section-{{ uid }} .hx-pdp__plan-top { display: flex; justify-content: space-between; align-items: center; }
  #shopify-section-{{ uid }} .hx-pdp__plan-name { font-weight: 600; font-size: 15px; color: var(--hx-heading); }
  #shopify-section-{{ uid }} .hx-pdp__plan-price { font-family: var(--hx-font-display); font-weight: 700; color: var(--hx-heading); }
  #shopify-section-{{ uid }} .hx-pdp__plan-price--save { color: var(--hx-glow); }
  #shopify-section-{{ uid }} .hx-pdp__plan-sub { display: block; color: var(--hx-muted); font-size: 13px; margin-top: 3px; }
  #shopify-section-{{ uid }} .hx-pdp__plan-badge {
    background: var(--hx-accent); color: #fff; font-size: 11px; font-weight: 600;
    padding: 4px 9px; border-radius: 100px; flex: 0 0 auto;
  }

  /* ---- Qty + ATC ---- */
  #shopify-section-{{ uid }} .hx-pdp__buy-row { margin-top: 24px; display: flex; gap: 14px; align-items: stretch; }
  #shopify-section-{{ uid }} .hx-pdp__qty {
    display: flex; align-items: center; border: 1px solid var(--hx-border); border-radius: 11px; overflow: hidden;
  }
  #shopify-section-{{ uid }} .hx-pdp__qty-btn {
    background: transparent; border: none; color: var(--hx-heading); font-size: 20px;
    width: 44px; height: 52px; cursor: pointer;
  }
  #shopify-section-{{ uid }} .hx-pdp__qty-btn:hover { color: var(--hx-accent); }
  #shopify-section-{{ uid }} .hx-pdp__qty-val { width: 40px; text-align: center; font-weight: 600; color: var(--hx-heading); }
  #shopify-section-{{ uid }} .hx-pdp__atc { flex: 1; box-shadow: 0 0 28px rgba(143,217,255,.26); }

  /* ---- Trust ---- */
  #shopify-section-{{ uid }} .hx-pdp__trust { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 14px 22px; color: var(--hx-slate); font-size: 13px; }
  #shopify-section-{{ uid }} .hx-pdp__trust-item { display: flex; align-items: center; gap: 7px; }
  #shopify-section-{{ uid }} .hx-pdp__diamond { color: var(--hx-accent); }

  /* ---- Benefit row ---- */
  #shopify-section-{{ uid }} .hx-pdp__benefits { border-top: 1px solid var(--hx-border); padding: clamp(48px, 6vw, 80px) 0; }
  #shopify-section-{{ uid }} .hx-pdp__benefits-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 24px; text-align: center;
  }
  #shopify-section-{{ uid }} .hx-pdp__benefit svg { margin: 0 auto; display: block; }
  #shopify-section-{{ uid }} .hx-pdp__benefit-label { font-size: 13.5px; margin-top: 12px; color: var(--hx-light-text); }

  /* ---- Why + Facts ---- */
  #shopify-section-{{ uid }} .hx-pdp__why-wrap { padding: clamp(48px, 6vw, 80px) 0; }
  #shopify-section-{{ uid }} .hx-pdp__why-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 36px; align-items: start;
  }
  #shopify-section-{{ uid }} .hx-pdp__why-h2 { margin-top: 14px; font-size: clamp(26px, 3.6vw, 40px); }
  #shopify-section-{{ uid }} .hx-pdp__why-body { margin-top: 18px; font-size: 16px; line-height: 1.65; }
  #shopify-section-{{ uid }} .hx-pdp__stats { margin-top: 24px; display: flex; gap: 24px; flex-wrap: wrap; }
  #shopify-section-{{ uid }} .hx-pdp__stat-num { font-family: var(--hx-font-display); font-weight: 700; font-size: 26px; color: var(--hx-heading); }
  #shopify-section-{{ uid }} .hx-pdp__stat-label { color: var(--hx-muted); font-size: 13px; }

  /* ---- Supplement Facts (dark text on soft white) ---- */
  #shopify-section-{{ uid }} .hx-pdp__facts { color: var(--hx-facts-ink); background: var(--hx-facts-bg); padding: 26px 28px; font-family: var(--hx-font-body); }
  #shopify-section-{{ uid }} .hx-pdp__facts * { color: inherit; }
  #shopify-section-{{ uid }} .hx-pdp__facts-title { font-family: var(--hx-font-display); font-weight: 800; font-size: 22px; border-bottom: 3px solid var(--hx-facts-ink); padding-bottom: 8px; }
  #shopify-section-{{ uid }} .hx-pdp__facts-serving { font-size: 12.5px; margin-top: 6px; }
  #shopify-section-{{ uid }} .hx-pdp__facts-dv { display: flex; justify-content: flex-end; font-size: 11px; font-weight: 700; border-bottom: 1px solid var(--hx-facts-ink); padding: 8px 0 4px; }
  #shopify-section-{{ uid }} .hx-pdp__fact-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--hx-facts-rule); font-size: 13.5px; }
  #shopify-section-{{ uid }} .hx-pdp__fact-row--indent { padding-left: 16px; color: var(--hx-gunmetal); }
  #shopify-section-{{ uid }} .hx-pdp__fact-row--heavy { border-bottom: 3px solid var(--hx-facts-ink); }
  #shopify-section-{{ uid }} .hx-pdp__fact-row:last-child { border-bottom: none; }
  #shopify-section-{{ uid }} .hx-pdp__facts-foot { font-size: 10.5px; color: var(--hx-gunmetal); margin-top: 8px; }

  /* ---- How to use ---- */
  #shopify-section-{{ uid }} .hx-pdp__howto { padding: clamp(40px, 5vw, 70px) 0; border-top: 1px solid var(--hx-border); }
  #shopify-section-{{ uid }} .hx-pdp__howto-grid {
    max-width: 900px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; text-align: center;
  }
  #shopify-section-{{ uid }} .hx-pdp__step-num { font-family: var(--hx-font-display); font-weight: 800; font-size: 36px; color: var(--hx-accent); }
  #shopify-section-{{ uid }} .hx-pdp__step-title { font-weight: 600; margin-top: 6px; color: var(--hx-heading); }
  #shopify-section-{{ uid }} .hx-pdp__step-desc { color: var(--hx-muted); font-size: 13.5px; margin-top: 6px; }

  /* ---- Bundle strip ---- */
  #shopify-section-{{ uid }} .hx-pdp__bundle-wrap { padding: clamp(40px, 5vw, 70px) 0; }
  #shopify-section-{{ uid }} .hx-pdp__bundle {
    border: 1px solid var(--hx-accent); border-radius: 18px; padding: clamp(26px, 4vw, 40px);
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    background: linear-gradient(120deg, rgba(45,107,255,.07), transparent 70%);
  }
  #shopify-section-{{ uid }} .hx-pdp__bundle-h3 { font-size: clamp(22px, 3vw, 30px); }
  #shopify-section-{{ uid }} .hx-pdp__bundle-body { margin-top: 8px; color: var(--hx-muted); font-size: 14.5px; }
  #shopify-section-{{ uid }} .hx-pdp__bundle-btn { white-space: nowrap; }

  /* ---- FAQ ---- */
  #shopify-section-{{ uid }} .hx-pdp__faq-wrap { padding: clamp(40px, 5vw, 70px) 0; }
  #shopify-section-{{ uid }} .hx-pdp__faq-h2 { font-size: clamp(24px, 3.4vw, 36px); text-align: center; margin-bottom: 34px; }

  /* ---- Sticky mobile add-to-cart (< 860px) ---- */
  #shopify-section-{{ uid }} .hx-pdp__sticky { display: none; }
  @media (max-width: 860px) {
    #shopify-section-{{ uid }} .hx-pdp__sticky {
      display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 50;
      align-items: center; gap: 12px; padding: 12px 16px;
      background: rgba(10,11,15,.95); backdrop-filter: blur(10px); border-top: 1px solid var(--hx-border);
    }
    #shopify-section-{{ uid }} .hx-pdp__sticky-info { flex: 0 0 auto; }
    #shopify-section-{{ uid }} .hx-pdp__sticky-total { font-family: var(--hx-font-display); font-weight: 700; font-size: 16px; color: var(--hx-heading); }
    #shopify-section-{{ uid }} .hx-pdp__sticky-meta { color: var(--hx-muted); font-size: 11px; }
    #shopify-section-{{ uid }} .hx-pdp__sticky-btn { flex: 1; box-shadow: none; }
    #shopify-section-{{ uid }} .hx-pdp__gallery { position: static; }
  }
{% endstyle %}

