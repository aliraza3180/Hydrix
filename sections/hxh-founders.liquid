{{ 'hydrix.css' | asset_url | stylesheet_tag }}
{%- comment -%} HYDRIX — "Founders Club" elevated panel + 2-column perks checklist {%- endcomment -%}

{%- liquid assign s = section.settings -%}

<section class="hx-section hxh-founders" style="--hx-bg:{{ s.bg }};--hx-heading:{{ s.heading_color }};--hx-body:{{ s.body_color }};--hx-accent:{{ s.accent }};--hx-accent-hover:{{ s.accent_hover }};--hx-border:{{ s.border }};--hxh-panel-border:{{ s.panel_border }};--hxh-glow:{{ s.glow }};--hxh-panel-top:{{ s.panel_top }};--hxh-panel-bottom:{{ s.panel_bottom }};padding:{{ s.padding }}px 24px;">
  {% render 'hydrix-bg', settings: section.settings %}
  <div class="hx-wrap">
    <div class="hxh-founders__panel scroll-trigger animate--fade-in">
      <div class="hxh-founders__left">
        {%- if s.show_safe == nil or s.show_safe -%}
          <div class="hxh-founders__safe-wrap">
            {%- if s.safe_image != blank -%}
              <img class="hxh-founders__safe" src="{{ s.safe_image | image_url: width: 460 }}" alt="{{ s.safe_alt | default: 'HYDRIX founder vault' }}" width="{{ s.safe_image.width }}" height="{{ s.safe_image.height }}" loading="lazy">
            {%- else -%}
              <img class="hxh-founders__safe" src="{{ 'hydrix-safe.png' | asset_url }}" alt="{{ s.safe_alt | default: 'HYDRIX founder vault' }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if s.eyebrow != blank -%}<div class="hx-eyebrow hxh-founders__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="hx-h2 hxh-founders__h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.body != blank -%}<p class="hx-body hxh-founders__body">{{ s.body }}</p>{%- endif -%}
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_url }}" class="hx-btn hxh-founders__btn">{{ s.button_label }}</a>
        {%- endif -%}
      </div>

      <div class="hxh-founders__right">
        <div class="hx-grid hxh-founders__list scroll-trigger animate--slide-in">
          {%- for block in section.blocks -%}
            <div class="hxh-founders__perk" {{ block.shopify_attributes }}>
              <span class="hxh-founders__check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--hx-accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span class="hxh-founders__perk-text">{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hxh-founders__panel {
    position: relative;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 5vw, 56px); align-items: center;
    border-radius: 32px; padding: clamp(32px, 5vw, 56px);
    border: 1px solid rgba(255,255,255,.10);
    background: linear-gradient(180deg, rgba(27,30,37,.85) 0%, rgba(14,16,20,.65) 100%);
    backdrop-filter: blur(14px);
    box-shadow: 0 0 80px var(--hxh-glow);
  }
  #shopify-section-{{ section.id }} .hxh-founders__safe-wrap {
    position: relative; margin-bottom: 22px; width: fit-content;
  }
  #shopify-section-{{ section.id }} .hxh-founders__safe-wrap::after {
    content: ''; position: absolute; inset: -18% -14% -26% -14%;
    background: radial-gradient(ellipse at 62% 48%, rgba(59,130,246,.34), transparent 66%);
    filter: blur(24px); z-index: 0; pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hxh-founders__safe {
    position: relative; z-index: 1; display: block; height: auto;
    width: clamp(140px, 20vw, 190px);
    filter: drop-shadow(0 24px 44px rgba(0,0,0,.55));
  }
  #shopify-section-{{ section.id }} .hxh-founders__eyebrow {
    font-family: var(--hx-font-sora); font-weight: 500; font-size: 11px;
    letter-spacing: .22em; text-transform: uppercase; color: var(--hx-body);
  }
  #shopify-section-{{ section.id }} .hxh-founders__h2 {
    font-family: var(--hx-font-sora); font-weight: 600; letter-spacing: -.025em;
    font-size: clamp(32px, 4.4vw, 52px); line-height: 1.05; margin-top: 14px;
  }
  #shopify-section-{{ section.id }} .hxh-founders__body {
    margin-top: 16px; max-width: 460px; font-size: 15px;
  }
  #shopify-section-{{ section.id }} .hxh-founders__btn {
    margin-top: 28px; border-radius: 9999px; font-family: var(--hx-font-body); font-weight: 500;
  }
  #shopify-section-{{ section.id }} .hxh-founders__list {
    grid-template-columns: repeat(2, 1fr); gap: 16px 24px;
  }
  #shopify-section-{{ section.id }} .hxh-founders__perk {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 14px; color: var(--hx-heading); line-height: 1.4;
    padding: 14px 16px; border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(180deg, rgba(255,255,255,.04) 0%, rgba(255,255,255,.015) 100%);
    backdrop-filter: blur(8px);
  }
  #shopify-section-{{ section.id }} .hxh-founders__check {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; border-radius: 9999px;
    background: var(--hx-card-bg, #FFFFFF05); border: 1px solid var(--hxh-panel-border);
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .hxh-founders__list { grid-template-columns: 1fr; }
  }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX Founders",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FOUNDERS CLUB · $5" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build the future of hydration with us." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Lock in lifetime founder pricing, early access to new releases and a permanent place in the HYDRIX story." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Reserve my spot" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 88 },
    { "type": "header", "content": "Founder vault image" },
    { "type": "checkbox", "id": "show_safe", "label": "Show vault image", "default": true },
    { "type": "image_picker", "id": "safe_image", "label": "Vault image", "info": "Leave empty to use the bundled transparent vault PNG. Use a transparent-background PNG." },
    { "type": "text", "id": "safe_alt", "label": "Vault image alt text", "default": "HYDRIX founder vault" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body / secondary", "default": "#8E96A3" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3B82F6" },
    { "type": "color", "id": "accent_hover", "label": "Accent hover", "default": "#5B97F8" },
    { "type": "color", "id": "border", "label": "Faint border", "default": "#FFFFFF14" },
    { "type": "color", "id": "panel_border", "label": "Panel border (accent-tinted)", "default": "#3B82F659" },
    { "type": "color", "id": "panel_top", "label": "Panel gradient top", "default": "#101626" },
    { "type": "color", "id": "panel_bottom", "label": "Panel gradient bottom", "default": "#0A0B0F" },
    { "type": "color", "id": "glow", "label": "Panel glow", "default": "#3B82F61F" }
  ],
  "blocks": [
    { "type": "perk", "name": "Perk", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Lifetime founder pricing" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "home",
      "settings": {
        "eyebrow": "FOUNDERS CLUB · $5",
        "heading": "Build the future of hydration with us.",
        "body": "Lock in lifetime founder pricing, early access to new releases and a permanent place in the HYDRIX story.",
        "button_label": "Reserve my spot",
        "button_url": "#waitlist"
      },
      "blocks": [
        { "type": "perk", "settings": { "text": "Lifetime founder pricing" } },
        { "type": "perk", "settings": { "text": "Early access drops" } },
        { "type": "perk", "settings": { "text": "Exclusive releases" } },
        { "type": "perk", "settings": { "text": "Priority shipping" } },
        { "type": "perk", "settings": { "text": "VIP community" } },
        { "type": "perk", "settings": { "text": "Founder's badge" } }
      ]
    }
  ]
}
{% endschema %}
