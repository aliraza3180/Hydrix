{%- comment -%} HYDRIX — Announcement bar (slim, shimmer) {%- endcomment -%}
{{ 'hydrix.css' | asset_url | stylesheet_tag }}

<div class="hx-section hx-announce" style="
  --hx-bg: {{ section.settings.bg }};
  --hx-accent: {{ section.settings.accent }};
  border-bottom: 1px solid {{ section.settings.border }};
">
  {%- if section.settings.show_shimmer -%}
    <div class="hx-announce__shimmer"></div>
  {%- endif -%}
  <div class="hx-announce__text" style="color: {{ section.settings.text_color }};">
    {{ section.settings.text }}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .hx-announce { overflow: hidden; }
  #shopify-section-{{ section.id }} .hx-announce__shimmer {
    position: absolute; top: 0; bottom: 0; width: 40%;
    background: linear-gradient(90deg, transparent, rgba(143,217,255,.10), transparent);
    animation: hxSweep {{ section.settings.shimmer_speed }}s linear infinite; pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hx-announce__text {
    text-align: center; padding: 11px 18px; font-size: {{ section.settings.font_size }}px;
    letter-spacing: .02em; position: relative; font-family: var(--hx-font-body);
  }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX Announcement",
  "tag": "section",
  "class": "hx-announce-section",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>◆&nbsp; Founding access is open — early supporters lock a <strong>lifetime founder's discount</strong>.</p>" },
    { "type": "range", "id": "font_size", "label": "Font size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },
    { "type": "checkbox", "id": "show_shimmer", "label": "Show light shimmer", "default": true },
    { "type": "range", "id": "shimmer_speed", "label": "Shimmer speed", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2D6BFF" },
    { "type": "color", "id": "border", "label": "Bottom border", "default": "#20242A" }
  ],
  "presets": [{ "name": "HYDRIX Announcement" }]
}
{% endschema %}
