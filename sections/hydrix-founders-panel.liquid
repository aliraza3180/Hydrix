{%- comment -%} HYDRIX — Founder's Club elevated panel {%- endcomment -%}
{{ 'hydrix.css' | asset_url | stylesheet_tag }}

{%- liquid assign s = section.settings -%}

<section class="hx-section hx-founders" style="
  --hx-bg: {{ s.bg }};
  --hx-heading: {{ s.heading_color }};
  --hx-body: {{ s.body_color }};
  --hx-accent: {{ s.accent }};
  --hx-accent-hover: {{ s.accent_hover }};
  padding: {{ s.padding }}px 24px;
">
  {% render 'hydrix-bg', settings: section.settings %}
  <div class="hx-founders__halo"></div>
  <div class="hx-founders__panel scroll-trigger animate--slide-in" style="
    background: linear-gradient(180deg, {{ s.panel_top }}, {{ s.panel_bottom }});
    border: 1px solid {{ s.accent }};
  ">
    {%- if s.show_safe == nil or s.show_safe -%}
      <div class="hx-founders__safe-wrap">
        {%- if s.safe_image != blank -%}
          <img class="hx-founders__safe" src="{{ s.safe_image | image_url: width: 420 }}" alt="{{ s.safe_alt | default: 'HYDRIX founder vault' }}" width="{{ s.safe_image.width }}" height="{{ s.safe_image.height }}" loading="lazy">
        {%- else -%}
          <img class="hx-founders__safe" src="{{ 'hydrix-safe.png' | asset_url }}" alt="{{ s.safe_alt | default: 'HYDRIX founder vault' }}" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.eyebrow != blank -%}<div class="hx-eyebrow" style="color:{{ s.eyebrow_color }}">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="hx-h2 hx-founders__h2">{{ s.heading }}</h2>
    {%- if s.subheading != blank -%}<p class="hx-founders__sub">{{ s.subheading }}</p>{%- endif -%}
    <div class="hx-founders__list">
      {%- for block in section.blocks -%}
        <div class="hx-founders__item" {{ block.shopify_attributes }}><span class="hx-accent-text" style="flex:0 0 auto">✓</span> {{ block.settings.text }}</div>
      {%- endfor -%}
    </div>
    <div class="hx-founders__cta">
      {%- if s.price != blank -%}<div class="hx-founders__price">{{ s.price }}</div>{%- endif -%}
      {%- if s.pledge_product != blank or s.pledge_variant_id != blank -%}
        {%- if s.pledge_product != blank -%}{%- assign pvid = s.pledge_product.selected_or_first_available_variant.id -%}{%- else -%}{%- assign pvid = s.pledge_variant_id -%}{%- endif -%}
        <form action="{{ routes.cart_add_url }}" method="post" class="hx-founders__pledge">
          <input type="hidden" name="id" value="{{ pvid }}">
          <input type="hidden" name="return_to" value="/checkout">
          <button type="submit" class="hx-btn">{{ s.button_label }}</button>
        </form>
      {%- else -%}
        <a href="{{ s.button_url }}" class="hx-btn">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
    {%- if s.note != blank -%}<div class="hx-founders__note" style="color:{{ s.note_color }}">{{ s.note }}</div>{%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hx-founders { position: relative; }
  #shopify-section-{{ section.id }} .hx-founders__halo {
    position: absolute; top: -100px; left: 50%; transform: translateX(-50%); width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(45,107,255,.14), transparent 60%); pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hx-founders__panel {
    position: relative; max-width: 680px; margin: 0 auto; border-radius: 20px;
    padding: clamp(30px, 5vw, 52px);
    box-shadow: 0 0 60px rgba(45,107,255,.18), inset 0 1px 0 rgba(216,220,227,.2), inset 0 0 60px rgba(143,217,255,.06);
  }
  #shopify-section-{{ section.id }} .hx-founders__safe-wrap { position: relative; width: fit-content; margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .hx-founders__safe-wrap::after {
    content: ''; position: absolute; inset: -16% -12% -24% -12%;
    background: radial-gradient(ellipse at 60% 46%, rgba(59,130,246,.40), transparent 66%);
    filter: blur(22px); z-index: 0; pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hx-founders__safe {
    position: relative; z-index: 1; display: block; height: auto;
    width: clamp(120px, 16vw, 158px); filter: drop-shadow(0 20px 40px rgba(0,0,0,.55));
  }
  #shopify-section-{{ section.id }} .hx-founders__h2 { margin-top: 14px; font-size: clamp(28px,4vw,44px); }
  #shopify-section-{{ section.id }} .hx-founders__sub { margin-top: 14px; color: var(--hx-body); font-size: 16px; line-height: 1.6; }
  #shopify-section-{{ section.id }} .hx-founders__list { margin-top: 28px; display: flex; flex-direction: column; gap: 14px; }
  #shopify-section-{{ section.id }} .hx-founders__item { display: flex; align-items: center; gap: 12px; font-size: 15px; color: var(--hx-heading); }
  #shopify-section-{{ section.id }} .hx-founders__cta { margin-top: 32px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .hx-founders__price { font-family: var(--hx-font-display); font-weight: 800; font-size: 44px; line-height: 1; color: var(--hx-heading); }
  #shopify-section-{{ section.id }} .hx-founders__note { margin-top: 20px; font-size: 13px; }
  #shopify-section-{{ section.id }} .hx-founders__pledge { margin: 0; display: inline-flex; }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX Founder's Panel",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Founder's Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Founder's Club." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pledge $5 today and lock perks the public will never get." },
    { "type": "text", "id": "price", "label": "Price", "default": "$5" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Become a Founder — $5" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "product", "id": "pledge_product", "label": "Pledge product (real $5 checkout)", "info": "Pick the $5 Founders Club product → button adds it and sends the customer straight to checkout. Leave empty to use the link above." },
    { "type": "text", "id": "pledge_variant_id", "label": "…or pledge Variant ID", "info": "Alternative to the product picker: paste the $5 product's Variant ID to send the button straight to checkout. Ignored if a product is picked above." },
    { "type": "text", "id": "note", "label": "Note", "default": "Fully credited toward your first order. Limited founding spots." },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 88 },
    { "type": "header", "content": "Founder vault image" },
    { "type": "checkbox", "id": "show_safe", "label": "Show vault image", "default": true },
    { "type": "image_picker", "id": "safe_image", "label": "Vault image", "info": "Leave empty to use the bundled transparent vault PNG. Use a transparent-background PNG." },
    { "type": "text", "id": "safe_alt", "label": "Vault image alt text", "default": "HYDRIX founder vault" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "panel_top", "label": "Panel gradient top", "default": "#16181f" },
    { "type": "color", "id": "panel_bottom", "label": "Panel gradient bottom", "default": "#101218" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body", "default": "#6C7685" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#8FD9FF" },
    { "type": "color", "id": "accent", "label": "Accent / border", "default": "#2D6BFF" },
    { "type": "color", "id": "accent_hover", "label": "Accent hover", "default": "#3B7EFF" },
    { "type": "color", "id": "note_color", "label": "Note", "default": "#F5B400" }
  ],
  "blocks": [
    { "type": "perk", "name": "Perk", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Lifetime Founder's Discount" } ] }
  ],
  "presets": [{ "name": "HYDRIX Founder's Panel", "blocks": [
    { "type": "perk", "settings": { "text": "Lifetime Founder's Discount" } },
    { "type": "perk", "settings": { "text": "First access at launch (before the waitlist)" } },
    { "type": "perk", "settings": { "text": "Exclusive founder-only flavor drop" } },
    { "type": "perk", "settings": { "text": "Founding member badge & name on the wall" } }
  ]}]
}
{% endschema %}
