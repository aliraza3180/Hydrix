{%- comment -%} HYDRIX — Shop grid (breadcrumb + intro + filter chips + product card grid). {%- endcomment -%}
{{ 'hydrix.css' | asset_url | stylesheet_tag }}

{%- liquid assign s = section.settings -%}

<section class="hx-section hx-shop" style="
  --hx-bg: {{ s.bg }};
  --hx-heading: {{ s.heading_color }};
  --hx-body: {{ s.body_color }};
  --hx-accent: {{ s.accent }};
  --hx-border: {{ s.border }};
  --hx-card-bg: {{ s.card_bg }};
  padding: {{ s.padding }}px 24px;
">
  {% render 'hydrix-bg', settings: section.settings %}
  <div class="hx-wrap">
    <div class="hx-shop__head scroll-trigger animate--fade-in">
      {%- if s.breadcrumb != blank -%}<div class="hx-shop__crumb">{{ s.breadcrumb }}</div>{%- endif -%}
      {%- if s.heading != blank -%}<h1 class="hx-h1 hx-shop__title">{{ s.heading }}</h1>{%- endif -%}
      {%- if s.intro != blank -%}<p class="hx-lead hx-shop__intro">{{ s.intro }}</p>{%- endif -%}
    </div>

    {%- assign chip_blocks = section.blocks | where: 'type', 'filter' -%}
    {%- assign product_blocks = section.blocks | where: 'type', 'product' -%}

    {%- if chip_blocks.size > 0 or s.sort_label != blank -%}
      <div class="hx-shop__bar scroll-trigger animate--fade-in">
        <div class="hx-shop__chips">
          {%- for block in chip_blocks -%}
            <button type="button" class="hx-chip{% if block.settings.active %} hx-chip--active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {%- endfor -%}
        </div>
        {%- if s.sort_label != blank -%}
          <div class="hx-shop__sort">Sort: <span>{{ s.sort_label }} &#9662;</span></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hx-grid hx-shop__grid scroll-trigger animate--slide-in">
      {%- for block in product_blocks -%}
        {%- assign bs = block.settings -%}
        {%- assign accent = bs.accent | default: s.accent -%}
        {%- capture card_inner -%}
          <div class="hx-shop__media" style="--hx-accent:{{ accent }}">
            {%- if bs.image != blank -%}
              <img src="{{ bs.image | image_url: width: 600 }}" alt="{{ bs.title | escape }}" class="hx-shop__img" loading="lazy" width="600" height="600">
            {%- else -%}
              <div class="hx-tub hx-shop__tub" style="box-shadow:0 0 40px {{ accent | color_modify: 'alpha', 0.4 }},inset 0 10px 0 -5px #2a2e36">
                <span class="hx-shop__rim" style="background:linear-gradient(180deg,{{ bs.rim_top | default: '#8FD9FF' }},{{ accent }})"></span>
              </div>
            {%- endif -%}
            {%- if bs.tag != blank -%}
              <span class="hx-shop__tag" style="color:{{ accent }}">{{ bs.tag }}</span>
            {%- endif -%}
          </div>
          <div class="hx-shop__row">
            <div class="hx-shop__name" style="color:{{ accent }}">{{ bs.title }}</div>
            {%- if bs.price != blank -%}<div class="hx-shop__price">{{ bs.price }}</div>{%- endif -%}
          </div>
          {%- if bs.subtitle != blank -%}<div class="hx-shop__sub">{{ bs.subtitle }}</div>{%- endif -%}
        {%- endcapture -%}

        <div class="hx-card hx-card--glow hx-shop__card" style="--hx-accent:{{ accent }}" {{ block.shopify_attributes }}>
          {%- if bs.link != blank -%}
            <a href="{{ bs.link }}" class="hx-shop__link">{{ card_inner }}</a>
          {%- else -%}
            <div class="hx-shop__link">{{ card_inner }}</div>
          {%- endif -%}
          {%- if bs.cta_label != blank -%}
            {%- if bs.cta_solid -%}
              <a href="{{ bs.link | default: '#' }}" class="hx-shop__cta hx-shop__cta--solid" style="background:{{ accent }}">{{ bs.cta_label }}</a>
            {%- else -%}
              <button type="button" class="hx-shop__cta hx-shop__cta--ghost">{{ bs.cta_label }}</button>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if s.upsell_heading != blank -%}
      <div class="hx-shop__upsell scroll-trigger animate--fade-in">
        <div>
          <h3 class="hx-h3 hx-shop__upsell-title">{{ s.upsell_heading }}</h3>
          {%- if s.upsell_text != blank -%}<p class="hx-shop__upsell-text">{{ s.upsell_text }}</p>{%- endif -%}
        </div>
        {%- if s.upsell_btn_label != blank -%}
          <a href="{{ s.upsell_btn_link | default: '#' }}" class="hx-btn hx-shop__upsell-btn">{{ s.upsell_btn_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hx-shop__grid { grid-template-columns: repeat(auto-fit, minmax({{ s.min_card }}px, 1fr)); }
  #shopify-section-{{ section.id }} .hx-shop__head { text-align: left; margin-bottom: 28px; }
  #shopify-section-{{ section.id }} .hx-shop__crumb { color: var(--hx-body); font-size: 13px; }
  #shopify-section-{{ section.id }} .hx-shop__title { margin-top: 10px; font-size: clamp(34px, 5vw, 56px); }
  #shopify-section-{{ section.id }} .hx-shop__intro { margin-top: 12px; max-width: 520px; }
  #shopify-section-{{ section.id }} .hx-shop__bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-bottom: 1px solid var(--hx-border); padding-bottom: 18px; margin-bottom: 32px; }
  #shopify-section-{{ section.id }} .hx-shop__chips { display: flex; gap: 10px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .hx-shop__sort { color: var(--hx-body); font-size: 13px; }
  #shopify-section-{{ section.id }} .hx-shop__sort span { color: var(--hx-heading); }
  #shopify-section-{{ section.id }} .hx-shop__card { padding: 28px; border-radius: 18px; display: flex; flex-direction: column; }
  #shopify-section-{{ section.id }} .hx-shop__link { text-decoration: none; color: inherit; display: block; }
  #shopify-section-{{ section.id }} .hx-shop__media { position: relative; aspect-ratio: 1/1; border-radius: 14px; overflow: hidden; background: radial-gradient(ellipse at center, color-mix(in srgb, var(--hx-accent) 16%, transparent), transparent 64%), #070809; display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .hx-shop__img { width: 90%; height: 90%; object-fit: contain; }
  #shopify-section-{{ section.id }} .hx-shop__tub { width: 120px; height: 160px; border-radius: 18px 18px 12px 12px; }
  #shopify-section-{{ section.id }} .hx-shop__tub::after { content: none; }
  #shopify-section-{{ section.id }} .hx-shop__rim { position: absolute; top: 18px; left: 50%; transform: translateX(-50%); width: 3px; height: 62%; }
  #shopify-section-{{ section.id }} .hx-shop__tag { position: absolute; top: 14px; right: 14px; background: var(--hx-border); font-size: 11px; padding: 5px 10px; border-radius: 100px; }
  #shopify-section-{{ section.id }} .hx-shop__row { margin-top: 18px; display: flex; justify-content: space-between; align-items: baseline; }
  #shopify-section-{{ section.id }} .hx-shop__name { font-family: var(--hx-font-display); font-weight: 700; font-size: 20px; }
  #shopify-section-{{ section.id }} .hx-shop__price { font-weight: 600; color: var(--hx-heading); }
  #shopify-section-{{ section.id }} .hx-shop__sub { color: var(--hx-body); font-size: 13px; margin-top: 4px; }
  #shopify-section-{{ section.id }} .hx-shop__cta { margin-top: 18px; text-align: center; text-decoration: none; font-weight: 600; font-size: 14px; padding: 12px; border-radius: 9px; transition: all .2s; cursor: pointer; display: block; }
  #shopify-section-{{ section.id }} .hx-shop__cta--solid { color: #fff; }
  #shopify-section-{{ section.id }} .hx-shop__cta--solid:hover { filter: brightness(1.1); }
  #shopify-section-{{ section.id }} .hx-shop__cta--ghost { background: transparent; border: 1px solid var(--hx-border); color: var(--hx-heading); width: 100%; }
  #shopify-section-{{ section.id }} .hx-shop__cta--ghost:hover { border-color: var(--hx-accent); }
  #shopify-section-{{ section.id }} .hx-shop__upsell { margin-top: 24px; border: 1px solid var(--hx-accent); border-radius: 18px; padding: clamp(26px, 4vw, 40px); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; background: linear-gradient(120deg, color-mix(in srgb, var(--hx-accent) 7%, transparent), transparent 70%); }
  #shopify-section-{{ section.id }} .hx-shop__upsell-title { font-size: clamp(22px, 3vw, 30px); }
  #shopify-section-{{ section.id }} .hx-shop__upsell-text { margin-top: 8px; color: var(--hx-body); font-size: 14.5px; }
  #shopify-section-{{ section.id }} .hx-shop__upsell-btn { white-space: nowrap; }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX Shop Grid",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "text", "id": "breadcrumb", "label": "Breadcrumb", "default": "Shop / All products" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The full system" },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph", "default": "Four formulas, one engineering standard. Zero sugar, seven electrolytes, third-party tested." },
    { "type": "text", "id": "sort_label", "label": "Sort label (presentational)", "default": "Featured" },
    { "type": "range", "id": "min_card", "label": "Min card width", "min": 200, "max": 340, "step": 10, "unit": "px", "default": 250 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Subscription upsell" },
    { "type": "text", "id": "upsell_heading", "label": "Upsell heading", "default": "Subscribe & save 15% on any formula" },
    { "type": "textarea", "id": "upsell_text", "label": "Upsell text", "default": "Free shipping, founder pricing locked, skip or cancel anytime." },
    { "type": "text", "id": "upsell_btn_label", "label": "Upsell button label", "default": "Start a subscription" },
    { "type": "url", "id": "upsell_btn_link", "label": "Upsell button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body", "default": "#6C7685" },
    { "type": "color", "id": "accent", "label": "Default accent", "default": "#2D6BFF" },
    { "type": "color", "id": "border", "label": "Card border", "default": "#20242A" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#0A0B0F" }
  ],
  "blocks": [
    { "type": "filter", "name": "Filter chip", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "All" },
      { "type": "checkbox", "id": "active", "label": "Active", "default": false }
    ]},
    { "type": "product", "name": "Product", "settings": [
      { "type": "text", "id": "title", "label": "Name", "default": "DAILY" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Everyday hydration" },
      { "type": "text", "id": "price", "label": "Price", "default": "$49" },
      { "type": "text", "id": "tag", "label": "Tag (e.g. New)" },
      { "type": "image_picker", "id": "image", "label": "Product image (else tub silhouette)" },
      { "type": "color", "id": "accent", "label": "Accent (name + glow)" },
      { "type": "color", "id": "rim_top", "label": "Rim gradient top", "default": "#8FD9FF" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "cta_label", "label": "CTA label (optional)" },
      { "type": "checkbox", "id": "cta_solid", "label": "Solid CTA (else ghost Quick add)", "default": false }
    ]}
  ],
  "presets": [{ "name": "HYDRIX Shop Grid", "blocks": [
    { "type": "filter", "settings": { "label": "All", "active": true } },
    { "type": "filter", "settings": { "label": "Hydration", "active": false } },
    { "type": "filter", "settings": { "label": "Energy", "active": false } },
    { "type": "filter", "settings": { "label": "Recovery", "active": false } },
    { "type": "product", "settings": { "title": "DAILY", "subtitle": "Glacier Citrus · Everyday hydration", "price": "$49", "accent": "#2D6BFF", "rim_top": "#8FD9FF", "link": "/pages/product-daily", "cta_label": "Shop DAILY", "cta_solid": true } },
    { "type": "product", "settings": { "title": "FOCUS", "subtitle": "Yuzu Green · Clarity & energy", "price": "$49", "tag": "New", "accent": "#22D37D", "rim_top": "#7DFFC2", "cta_label": "Quick add", "cta_solid": false } },
    { "type": "product", "settings": { "title": "ACTIVE", "subtitle": "Blood Orange · Performance", "price": "$49", "tag": "New", "accent": "#FF6B1A", "rim_top": "#FFBC66", "cta_label": "Quick add", "cta_solid": false } },
    { "type": "product", "settings": { "title": "RECOVER", "subtitle": "Wild Berry · Rest & repair", "price": "$49", "tag": "New", "accent": "#8E9BFF", "rim_top": "#CFA4FF", "cta_label": "Quick add", "cta_solid": false } }
  ]}]
}
{% endschema %}
