    { "type": "color", "id": "gold_to", "label": "Gold end", "default": "#B8860B" }
  ],
  "blocks": [
    { "type": "tier", "name": "Reward tier", "settings": [
      { "type": "text", "id": "count", "label": "Referral count", "default": "5" },
      { "type": "textarea", "id": "reward", "label": "Reward", "default": "Free shipping + Founder sticker pack" },
      { "type": "range", "id": "threshold_percent", "label": "Reached at progress ≥", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0, "info": "This node glows when the progress fill reaches this value." }
    ]}
  ],
  "max_blocks": 6,
  "presets": [
    {
