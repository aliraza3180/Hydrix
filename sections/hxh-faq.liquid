{{ 'hydrix.css' | asset_url | stylesheet_tag }}
{%- comment -%} HYDRIX — hxh-faq. "Questions, answered." accordion. {%- endcomment -%}
{%- liquid assign s = section.settings -%}

<section class="hx-section hxh-faq" style="--hx-bg:{{ s.bg }};--hx-heading:{{ s.heading_color }};--hx-body:{{ s.body_color }};--hx-accent:{{ s.accent }};--hx-accent-hover:{{ s.accent_hover }};--hx-border:{{ s.border }};padding:{{ s.padding }}px 24px;">
  {% render 'hydrix-bg', settings: section.settings %}
  <div class="hx-wrap hx-wrap--narrow">
    <div class="hx-section-head scroll-trigger animate--slide-in">
      {%- if s.eyebrow != blank -%}<div class="hxh-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
      <h2 class="hxh-h2">{{ s.heading }}</h2>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="hxh-faq__list scroll-trigger animate--fade-in">
        {%- for block in section.blocks -%}
          <details class="hx-faq__item" {{ block.shopify_attributes }}>
            <summary class="hx-faq__q">
              <span>{{ block.settings.question }}</span>
              <span class="hx-faq__toggle">+</span>
            </summary>
            <div class="hx-faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hx-section-head { text-align: center; }
  #shopify-section-{{ section.id }} .hxh-eyebrow {
    font-family: var(--hx-font-sora); font-weight: 500; font-size: 11px;
    letter-spacing: .22em; text-transform: uppercase; color: var(--hx-body);
  }
  #shopify-section-{{ section.id }} .hxh-h2 {
    font-family: var(--hx-font-sora); font-weight: 600;
    font-size: clamp(32px, 4.4vw, 52px); line-height: 1.04; letter-spacing: -.025em;
    color: var(--hx-heading); margin: 12px 0 0;
  }
  #shopify-section-{{ section.id }} .hxh-faq__list { max-width: 760px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .hx-faq__item[open] .hx-faq__toggle { transform: rotate(45deg); }
{% endstyle %}

{% schema %}
{
  "name": "HXH FAQ",
  "tag": "section",
  "class": "hxh-faq-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding", "label": "Padding (top & bottom)", "min": 40, "max": 160, "step": 2, "unit": "px", "default": 96 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "heading_color", "label": "Heading text", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#8E96A3" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3B82F6" },
    { "type": "color", "id": "accent_hover", "label": "Accent hover", "default": "#5B97F8" },
    { "type": "color", "id": "border", "label": "Border", "default": "#FFFFFF14" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Q&A",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Your answer here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "home",
      "settings": {
        "eyebrow": "FAQ",
        "heading": "Questions, answered.",
        "padding": 96,
        "bg": "#0A0B0F",
        "heading_color": "#FFFFFF",
        "body_color": "#8E96A3",
        "accent": "#3B82F6",
        "accent_hover": "#5B97F8",
        "border": "#FFFFFF14"
      },
      "blocks": [
        { "type": "qa", "settings": { "question": "How is HYDRIX different from a sports drink?", "answer": "HYDRIX delivers a full-spectrum, clinically dosed electrolyte matrix with cellular co-factors and zero sugar. Sports drinks are mostly sugar and sodium." } },
        { "type": "qa", "settings": { "question": "When should I take it?", "answer": "Any time you need to hydrate — morning, around training, or to push through an afternoon dip. One scoop daily." } },
        { "type": "qa", "settings": { "question": "Is it third-party tested?", "answer": "Yes. Every batch is independently tested for purity, potency, and label accuracy." } },
        { "type": "qa", "settings": { "question": "Will it spike my blood sugar?", "answer": "No. HYDRIX is zero sugar and won't spike blood glucose." } },
        { "type": "qa", "settings": { "question": "What's your return policy?", "answer": "Love it or your money back — reach out within 30 days for a full refund." } }
      ]
    }
  ]
}
{% endschema %}
