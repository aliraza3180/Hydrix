{%- comment -%} HYDRIX — Science: left copy + right electrolyte rows list. {%- endcomment -%}
{{ 'hydrix.css' | asset_url | stylesheet_tag }}

{%- liquid assign s = section.settings -%}

<section class="hx-section hxh-science" style="--hx-bg:{{ s.bg }};--hx-heading:{{ s.heading_color }};--hx-body:{{ s.body_color }};--hx-accent:{{ s.accent }};--hx-border:{{ s.border }};--hx-row-bg:{{ s.row_bg }};padding:{{ s.padding }}px 24px;">
  {% render 'hydrix-bg', settings: section.settings %}
  <div aria-hidden="true" style="position:absolute;inset:0;z-index:0;pointer-events:none;background:linear-gradient(180deg, var(--hx-bg) 0%, rgba(0,0,0,0) 50%, var(--hx-bg) 100%)"></div>
  <div class="hx-wrap hxh-science__grid">

    <div class="hxh-science__copy scroll-trigger animate--slide-in">
      {%- if s.eyebrow != blank -%}<p class="hxh-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank or s.heading_accent != blank -%}
        <h2 class="hxh-h2">{{ s.heading }}<span class="hxh-h2__accent">{{ s.heading_accent }}</span></h2>
      {%- endif -%}
      {%- if s.body != blank -%}<p class="hxh-science__body">{{ s.body }}</p>{%- endif -%}
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link }}" class="hxh-pill">{{ s.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="hxh-science__list scroll-trigger animate--slide-in">
      {%- for block in section.blocks -%}
        {%- if block.type == 'electrolyte' -%}
          <div class="hxh-row" {{ block.shopify_attributes }}>
            <div class="hxh-row__main">
              {%- if block.settings.name != blank -%}<span class="hxh-row__name">{{ block.settings.name }}</span>{%- endif -%}
              {%- if block.settings.desc != blank -%}<span class="hxh-row__desc">{{ block.settings.desc }}</span>{%- endif -%}
            </div>
            {%- if block.settings.amount != blank -%}<span class="hxh-row__amount">{{ block.settings.amount }}</span>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hxh-science__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 88px); align-items: center; }
  #shopify-section-{{ section.id }} .hxh-eyebrow { font-family: var(--hx-font-sora); font-weight: 500; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--hx-body); margin: 0 0 18px; }
  #shopify-section-{{ section.id }} .hxh-h2 { font-family: var(--hx-font-sora); font-weight: 600; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.06; letter-spacing: -.025em; color: var(--hx-heading); margin: 0; }
  #shopify-section-{{ section.id }} .hxh-h2__accent { background: linear-gradient(135deg, #7DD3F0 0%, #4F96F5 35%, var(--hx-accent) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  #shopify-section-{{ section.id }} .hxh-science__body { font-family: var(--hx-font-body); color: var(--hx-body); font-size: clamp(15px, 1.6vw, 17px); line-height: 1.65; margin: 22px 0 0; max-width: 460px; }
  #shopify-section-{{ section.id }} .hxh-pill { display: inline-flex; align-items: center; margin-top: 28px; padding: 13px 26px; border-radius: 999px; border: 1px solid var(--hx-border); background: var(--hx-row-bg); color: var(--hx-heading); font-family: var(--hx-font-body); font-weight: 600; font-size: 14px; text-decoration: none; transition: border-color .2s, background .2s; }
  #shopify-section-{{ section.id }} .hxh-pill:hover { border-color: var(--hx-accent); }
  #shopify-section-{{ section.id }} .hxh-science__list { display: flex; flex-direction: column; border: 1px solid var(--hx-border); border-radius: 24px; background: var(--hx-row-bg); overflow: hidden; }
  #shopify-section-{{ section.id }} .hxh-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 26px; border-bottom: 1px solid rgba(255,255,255,.08); background: linear-gradient(180deg, rgba(255,255,255,.04) 0%, rgba(255,255,255,.015) 100%); backdrop-filter: blur(8px); }
  #shopify-section-{{ section.id }} .hxh-row:last-child { border-bottom: none; }
  #shopify-section-{{ section.id }} .hxh-row__main { display: flex; flex-direction: column; gap: 4px; }
  #shopify-section-{{ section.id }} .hxh-row__name { font-family: var(--hx-font-sora); font-weight: 600; font-size: 16px; color: var(--hx-heading); letter-spacing: -.01em; }
  #shopify-section-{{ section.id }} .hxh-row__desc { font-family: var(--hx-font-body); font-size: 13px; color: var(--hx-body); line-height: 1.4; }
  #shopify-section-{{ section.id }} .hxh-row__amount { font-family: var(--hx-font-sora); font-weight: 600; font-size: 16px; color: var(--hx-accent); white-space: nowrap; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .hxh-science__grid { grid-template-columns: 1fr; gap: 36px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX Science",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BACKED BY SCIENCE" },
    { "type": "text", "id": "heading", "label": "Heading (plain part)", "default": "Engineered at the " },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent part)", "default": "cellular level." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "HYDRIX combines a 7-electrolyte matrix with cellular hydration co-factors — taurine, inositol, AquaMin® sea minerals and Ionplex® — to move water where your body actually needs it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read the science" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/pages/science" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body / secondary", "default": "#8E96A3" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3B82F6" },
    { "type": "color", "id": "border", "label": "Faint border", "default": "#FFFFFF14" },
    { "type": "color", "id": "row_bg", "label": "Row / card background", "default": "#FFFFFF05" }
  ],
  "blocks": [
    { "type": "electrolyte", "name": "Electrolyte row", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Sodium" },
      { "type": "text", "id": "desc", "label": "Sub-label", "default": "Primary hydration driver" },
      { "type": "text", "id": "amount", "label": "Amount", "default": "500 mg" }
    ]}
  ],
  "presets": [
    { "name": "home", "blocks": [
      { "type": "electrolyte", "settings": { "name": "Sodium", "desc": "Primary hydration driver", "amount": "500 mg" } },
      { "type": "electrolyte", "settings": { "name": "Potassium", "desc": "Cellular electrolyte balance", "amount": "400 mg" } },
      { "type": "electrolyte", "settings": { "name": "Magnesium", "desc": "Recovery + nervous system", "amount": "100 mg" } },
      { "type": "electrolyte", "settings": { "name": "Chloride", "desc": "Fluid balance", "amount": "700 mg" } },
      { "type": "electrolyte", "settings": { "name": "Calcium", "desc": "Muscle contraction", "amount": "60 mg" } },
      { "type": "electrolyte", "settings": { "name": "Zinc + Selenium", "desc": "Immune & antioxidant support", "amount": "" } }
    ]}
  ]
}
{% endschema %}
