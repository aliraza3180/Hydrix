{%- comment -%} HYDRIX — Final CTA / newsletter (beam + arc + email capture). {%- endcomment -%}
{{ 'hydrix.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hydrix.js' | asset_url }}" defer="defer"></script>

{%- liquid assign s = section.settings -%}

<section class="hx-section hx-ctabeam" id="{{ s.anchor | default: 'cta' }}" style="
  --hx-bg: {{ s.bg }};
  --hx-heading: {{ s.heading_color }};
  --hx-body: {{ s.body_color }};
  --hx-accent: {{ s.accent }};
  --hx-accent-hover: {{ s.accent_hover }};
  --hx-border: {{ s.border }};
  padding: {{ s.padding }}px 24px; text-align: center;
">
  {% render 'hydrix-bg', settings: section.settings %}
  {%- if s.show_beam -%}<div class="hx-beam hx-beam--short"></div>{%- endif -%}
  {%- if s.show_arc -%}<div class="hx-arc"></div>{%- endif -%}
  <div class="hx-ctabeam__inner scroll-trigger animate--slide-in">
    {%- if s.show_safe -%}
      <div class="hx-ctabeam__safe-wrap">
        {%- if s.safe_image != blank -%}
          <img class="hx-ctabeam__safe" src="{{ s.safe_image | image_url: width: 320 }}" alt="{{ s.safe_alt | default: 'HYDRIX founder vault' }}" width="{{ s.safe_image.width }}" height="{{ s.safe_image.height }}" loading="lazy">
        {%- else -%}
          <img class="hx-ctabeam__safe" src="{{ 'hydrix-safe.png' | asset_url }}" alt="{{ s.safe_alt | default: 'HYDRIX founder vault' }}" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.eyebrow != blank -%}<div class="hx-eyebrow" style="margin-bottom:14px">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="hx-h2 hx-ctabeam__h2">{{ s.heading }}</h2>
    {%- if s.subheading != blank -%}<p class="hx-lead" style="margin-top:14px">{{ s.subheading }}</p>{%- endif -%}

    {%- if s.action_type == 'email' and s.use_viral_loops -%}
      <div class="hx-ctabeam__form" style="margin-top:26px"><form-widget ucid="{{ s.vl_campaign_id }}"></form-widget></div>
    {%- elsif s.action_type == 'email' -%}
      {% form 'customer', class: 'hx-ctabeam__form' %}
        {%- if form.posted_successfully? -%}
          <div class="hx-success" style="margin-top:26px"><span class="hx-success__check">✓</span><span style="color:#fff;font-size:15px">{{ s.success_text }}</span></div>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="{{ s.email_tag }}">
          <div class="hx-form-row" style="margin-top:26px">
            <input class="hx-input" type="email" name="contact[email]" placeholder="{{ s.email_placeholder }}" required>
            <button class="hx-btn" type="submit">{{ s.button_label }}</button>
          </div>
        {%- endif -%}
      {% endform %}
    {%- elsif s.action_type == 'button' -%}
      <a href="{{ s.button_url }}" class="hx-btn" style="margin-top:28px">{{ s.button_label }}</a>
    {%- endif -%}

    {%- if s.show_counter -%}
      <div class="hx-ctabeam__counter" style="color:{{ s.body_color }}">
        <span class="hx-ctabeam__count" data-hx-counter data-target="{{ s.counter_target }}" data-step="0" data-interval="0" style="color:{{ s.counter_color }}">{{ s.counter_target }}</span> {{ s.counter_label }}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hx-ctabeam__inner { position: relative; z-index: 5; max-width: 560px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .hx-ctabeam__safe-wrap { position: relative; width: fit-content; margin: 0 auto 22px; }
  #shopify-section-{{ section.id }} .hx-ctabeam__safe-wrap::after {
    content: ''; position: absolute; inset: -18% -16% -28% -16%;
    background: radial-gradient(ellipse at 58% 46%, rgba(45,107,255,.40), transparent 66%);
    filter: blur(22px); z-index: 0; pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hx-ctabeam__safe {
    position: relative; z-index: 1; display: block; height: auto;
    width: clamp(96px, 12vw, 124px); filter: drop-shadow(0 18px 36px rgba(0,0,0,.5));
  }
  #shopify-section-{{ section.id }} .hx-ctabeam__form .hx-form-row { justify-content: center; }
  #shopify-section-{{ section.id }} .hx-ctabeam__h2 { font-size: clamp(28px, 4.6vw, 62px); }
  #shopify-section-{{ section.id }} .hx-ctabeam__counter { margin-top: 22px; font-size: 15px; }
  #shopify-section-{{ section.id }} .hx-ctabeam__count { font-family: var(--hx-font-display); font-weight: 700; }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX CTA Beam",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "cta" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be first. Be founding." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Action" },
    { "type": "select", "id": "action_type", "label": "Action", "options": [
      { "value": "email", "label": "Email capture" }, { "value": "button", "label": "Button" }, { "value": "none", "label": "None" }
    ], "default": "email" },
    { "type": "checkbox", "id": "use_viral_loops", "label": "Use Viral Loops join form", "default": false, "info": "When on (Email capture only), replaces the email box with the Viral Loops form. Enable on the prelaunch page only." },
    { "type": "text", "id": "vl_campaign_id", "label": "Viral Loops campaign id", "default": "mFfbAfGXeOHEsFV07WAlJGN9uJY" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "email_tag", "label": "Subscriber tag", "default": "waitlist" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're in. Welcome to HYDRIX." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the Waitlist" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "header", "content": "Restated counter" },
    { "type": "checkbox", "id": "show_counter", "label": "Show counter line", "default": true },
    { "type": "number", "id": "counter_target", "label": "Counter value", "default": 3842 },
    { "type": "text", "id": "counter_label", "label": "Counter label", "default": "in line and growing." },
    { "type": "color", "id": "counter_color", "label": "Counter color", "default": "#8FD9FF" },
    { "type": "header", "content": "Founder vault image" },
    { "type": "checkbox", "id": "show_safe", "label": "Show vault image", "default": true },
    { "type": "image_picker", "id": "safe_image", "label": "Vault image", "info": "Leave empty to use the bundled transparent vault PNG. Use a transparent-background PNG." },
    { "type": "text", "id": "safe_alt", "label": "Vault image alt text", "default": "HYDRIX founder vault" },
    { "type": "header", "content": "Decoration & spacing" },
    { "type": "checkbox", "id": "show_beam", "label": "Show beam", "default": true },
    { "type": "checkbox", "id": "show_arc", "label": "Show arc", "default": true },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 60, "max": 160, "step": 2, "unit": "px", "default": 120 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body", "default": "#6C7685" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2D6BFF" },
    { "type": "color", "id": "accent_hover", "label": "Accent hover", "default": "#3B7EFF" },
    { "type": "color", "id": "border", "label": "Border / inputs", "default": "#20242A" }
  ],
  "presets": [{ "name": "HYDRIX CTA Beam" }]
}
{% endschema %}
