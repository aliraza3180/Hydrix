{{ 'hydrix.css' | asset_url | stylesheet_tag }}
{%- comment -%} HYDRIX — "Shop HYDRIX" product lineup with premium product cards. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign coll = s.collection
  assign has_products = false
  if coll != blank and coll.products_count > 0
    assign has_products = true
  endif
-%}

<section class="hx-section hxh-lineup" id="lineup" style="--hx-bg:{{ s.bg }};--hx-heading:{{ s.heading_color }};--hx-body:{{ s.body_color }};--hx-accent:{{ s.accent }};--hx-accent-hover:{{ s.accent_hover }};--hx-border:{{ s.border }};--hx-stage:{{ s.stage_bg }};padding:{{ s.padding }}px 24px;">
  {% render 'hydrix-bg', settings: section.settings %}
  <div class="hx-glow-bottom" style="opacity:.5"></div>
  <div class="hx-wrap">
    <div class="hxh-lineup__head scroll-trigger animate--fade-in">
      <div>
        {%- if s.eyebrow != blank -%}<div class="hxh-lineup__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
        {%- if s.heading != blank or s.heading_accent != blank -%}
          <h2 class="hxh-lineup__h2">{{ s.heading }}<span class="hxh-lineup__accent">{{ s.heading_accent }}</span></h2>
        {%- endif -%}
      </div>
      {%- if s.descriptor != blank -%}<p class="hxh-lineup__desc">{{ s.descriptor }}</p>{%- endif -%}
    </div>

    <div class="hxh-lineup__grid scroll-trigger animate--slide-in">
      {%- if has_products -%}
        {%- for product in coll.products limit: s.products_limit -%}
          {%- render 'hxh-product-card', product: product, accent: s.accent, rim_top: s.accent, atc_label: s.atc_label -%}
        {%- endfor -%}

      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- render 'hxh-product-card',
              product: b.product, block_attrs: block.shopify_attributes,
              badge: b.badge, title: b.title, flavor: b.flavor, price: b.price, compare_price: b.compare_price,
              rating: b.rating, accent: b.accent, rim_top: b.rim_top, image: b.image,
              url: b.button_url, button_label: b.button_label, atc_label: s.atc_label -%}
        {%- endfor -%}

      {%- else -%}
        <div class="hxh-lineup__empty">
          <div class="hxh-lineup__empty-title">{{ s.empty_title }}</div>
          <p class="hxh-lineup__empty-text">{{ s.empty_text }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hxh-lineup__head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    margin-bottom: clamp(30px, 4vw, 48px);
  }
  #shopify-section-{{ section.id }} .hxh-lineup__eyebrow {
    font-family: var(--hx-font-sora); font-weight: 500; font-size: 11px;
    letter-spacing: .22em; text-transform: uppercase; color: var(--hx-body);
  }
  #shopify-section-{{ section.id }} .hxh-lineup__h2 {
    font-family: var(--hx-font-sora); font-weight: 600; letter-spacing: -.025em;
    font-size: clamp(32px, 4.4vw, 52px); line-height: 1.05; margin-top: 14px; color: var(--hx-heading);
  }
  #shopify-section-{{ section.id }} .hxh-lineup__accent {
    background: linear-gradient(135deg, #7DD3F0 0%, #4F96F5 35%, var(--hx-accent) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  #shopify-section-{{ section.id }} .hxh-lineup__desc { color: var(--hx-body); font-size: 14.5px; line-height: 1.6; max-width: 320px; text-align: right; }

  #shopify-section-{{ section.id }} .hxh-lineup__grid {
    display: grid; grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr)); gap: 18px;
  }
  @media (max-width: 1000px) { #shopify-section-{{ section.id }} .hxh-lineup__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Mobile: swipeable scroll-snap slider (peek next card) */
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .hxh-lineup__grid {
      display: flex; grid-template-columns: none; gap: 14px;
      overflow-x: auto; scroll-snap-type: x mandatory;
      margin: 0 -24px; padding: 4px 24px 8px;
      scrollbar-width: none; -webkit-overflow-scrolling: touch;
    }
    #shopify-section-{{ section.id }} .hxh-lineup__grid::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .hxh-lineup__grid > * { scroll-snap-align: start; flex: 0 0 80%; }
    #shopify-section-{{ section.id }} .hxh-lineup__grid > .hxh-lineup__empty { flex: 0 0 100%; }
  }

  /* ---- Premium product card ---- */
  #shopify-section-{{ section.id }} .hxh-pl__card {
    position: relative; border-radius: 26px; padding: 14px;
    background: linear-gradient(180deg, rgba(255,255,255,.045) 0%, rgba(255,255,255,.015) 100%);
    border: 1px solid rgba(255,255,255,.08); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    display: flex; flex-direction: column;
    transition: border-color .22s, box-shadow .22s, transform .22s;
  }
  #shopify-section-{{ section.id }} .hxh-pl__card:hover {
    border-color: var(--p-accent); box-shadow: 0 18px 50px rgba(0,0,0,.4), 0 0 44px -10px var(--p-accent); transform: translateY(-3px);
  }
  #shopify-section-{{ section.id }} .hxh-pl__visual {
    position: relative; display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1 / 1; border-radius: 18px; overflow: hidden; text-decoration: none;
    background: radial-gradient(115% 75% at 50% 12%, rgba(255,255,255,.05), transparent 55%), var(--hx-stage, #07080B);
  }
  #shopify-section-{{ section.id }} .hxh-pl__glow {
    position: absolute; bottom: 4%; left: 50%; transform: translateX(-50%);
    width: 64%; height: 36%; border-radius: 50%;
    background: radial-gradient(circle, var(--p-accent), transparent 70%); opacity: .5; filter: blur(28px);
  }
  #shopify-section-{{ section.id }} .hxh-pl__img { position: relative; z-index: 1; width: 80%; height: 80%; object-fit: contain; display: block; }
  #shopify-section-{{ section.id }} .hxh-pl__badge {
    position: absolute; top: 12px; left: 12px; z-index: 3;
    font-family: var(--hx-font-sora); font-size: 10.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 100px; color: #fff; background: var(--p-accent);
  }
  /* CSS bottle placeholder */
  #shopify-section-{{ section.id }} .hxh-bottle {
    position: relative; z-index: 1; width: 46%; aspect-ratio: 3 / 4.2;
    border-radius: 18px 18px 16px 16px;
    background: linear-gradient(165deg, #23262e 0%, #14161c 46%, #0b0c10 100%);
    box-shadow: 0 24px 48px rgba(0,0,0,.55), inset 0 2px 0 rgba(255,255,255,.10), inset 0 -16px 28px rgba(0,0,0,.5);
    display: flex; align-items: flex-end; justify-content: center;
  }
  #shopify-section-{{ section.id }} .hxh-bottle__lid {
    position: absolute; top: -8%; left: 50%; transform: translateX(-50%); width: 62%; height: 13%;
    border-radius: 10px 10px 6px 6px; background: linear-gradient(180deg, #2a2e37, #15171c);
    box-shadow: 0 6px 14px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.12);
  }
  #shopify-section-{{ section.id }} .hxh-bottle__stripe {
    position: absolute; top: 15%; left: 50%; transform: translateX(-50%); width: 3px; height: 48%;
    border-radius: 3px; background: linear-gradient(180deg, var(--p-rim), var(--p-accent));
    box-shadow: 0 0 16px var(--p-accent);
  }
  #shopify-section-{{ section.id }} .hxh-bottle__name {
    position: relative; margin-bottom: 16%;
    font-family: var(--hx-font-sora); font-weight: 700; font-size: 11px; letter-spacing: .16em; color: var(--p-accent);
  }
  #shopify-section-{{ section.id }} .hxh-pl__body { padding: 16px 10px 8px; flex: 1; display: flex; flex-direction: column; }
  #shopify-section-{{ section.id }} .hxh-pl__top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  #shopify-section-{{ section.id }} .hxh-pl__title { font-family: var(--hx-font-sora); font-weight: 600; font-size: 17px; letter-spacing: -.02em; color: var(--hx-heading); }
  #shopify-section-{{ section.id }} .hxh-pl__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .hxh-pl__rating { font-size: 12.5px; color: var(--hx-body); white-space: nowrap; }
  #shopify-section-{{ section.id }} .hxh-pl__rating b { color: var(--p-accent); }
  #shopify-section-{{ section.id }} .hxh-pl__flavor { margin-top: 3px; font-size: 13px; color: var(--hx-body); }
  #shopify-section-{{ section.id }} .hxh-pl__foot { margin-top: auto; padding-top: 16px; display: flex; flex-direction: column; align-items: stretch; gap: 14px; }
  #shopify-section-{{ section.id }} .hxh-pl__foot form { width: 100%; margin: 0; }
  #shopify-section-{{ section.id }} .hxh-pl__price { font-family: var(--hx-font-sora); font-weight: 600; font-size: 18px; color: var(--hx-heading); }
  #shopify-section-{{ section.id }} .hxh-pl__price s { color: var(--hx-body); font-weight: 400; font-size: 13.5px; margin-left: 6px; }
  #shopify-section-{{ section.id }} .hxh-pl__btn {
    display: inline-flex; width: 100%; align-items: center; justify-content: center; gap: 6px;
    padding: 13px 16px; border-radius: 9999px;
    background: var(--p-accent); color: #fff; font-family: var(--hx-font-body); font-weight: 600; font-size: 14px;
    text-decoration: none; white-space: nowrap; cursor: pointer; transition: filter .2s, box-shadow .2s;
  }
  #shopify-section-{{ section.id }} .hxh-pl__btn:hover { filter: brightness(1.06); box-shadow: 0 0 24px -2px var(--p-accent); }

  #shopify-section-{{ section.id }} .hxh-lineup__empty {
    grid-column: 1 / -1; text-align: center; padding: clamp(48px, 8vw, 96px) 24px; border-radius: 26px;
    background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.015)); border: 1px solid rgba(255,255,255,.08);
  }
  #shopify-section-{{ section.id }} .hxh-lineup__empty-title { font-family: var(--hx-font-sora); font-weight: 600; font-size: 22px; color: var(--hx-heading); }
  #shopify-section-{{ section.id }} .hxh-lineup__empty-text { margin: 10px auto 0; max-width: 420px; color: var(--hx-body); font-size: 14.5px; line-height: 1.6; }
  @media (max-width: 700px) { #shopify-section-{{ section.id }} .hxh-lineup__desc { text-align: left; } }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX Lineup",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE LINEUP" },
    { "type": "text", "id": "heading", "label": "Heading (plain)", "default": "Shop " },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent)", "default": "HYDRIX." },
    { "type": "text", "id": "descriptor", "label": "Descriptor", "default": "Clinically dosed. Naturally flavored. Engineered for high performers." },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "If set (and it has products), real products render instead of the manual cards below." },
    { "type": "range", "id": "products_limit", "label": "Max products from collection", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "4" },
    { "type": "text", "id": "button_label", "label": "Placeholder button label", "default": "Shop" },
    { "type": "text", "id": "atc_label", "label": "Add to cart label (real products)", "default": "Add to cart" },
    { "type": "text", "id": "empty_title", "label": "Empty state title", "default": "No products yet" },
    { "type": "textarea", "id": "empty_text", "label": "Empty state text", "default": "Connect a collection or add product cards to populate the lineup." },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 40, "max": 120, "step": 2, "unit": "px", "default": 88 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "stage_bg", "label": "Product stage background", "default": "#07080B" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body / secondary", "default": "#8E96A3" },
    { "type": "color", "id": "accent", "label": "Accent (collection + heading)", "default": "#3B82F6" },
    { "type": "color", "id": "accent_hover", "label": "Accent hover", "default": "#5B97F8" },
    { "type": "color", "id": "border", "label": "Border", "default": "#FFFFFF14" }
  ],
  "blocks": [
    { "type": "product", "name": "Product card", "settings": [
      { "type": "product", "id": "product", "label": "Product", "info": "Pick a product → real card with image, price & working Add to cart. Leave empty for the placeholder card below." },
      { "type": "text", "id": "badge", "label": "Badge (optional)" },
      { "type": "text", "id": "title", "label": "Name (placeholder)", "default": "DAILY" },
      { "type": "text", "id": "flavor", "label": "Flavor / subtitle", "default": "Glacier Citrus" },
      { "type": "text", "id": "price", "label": "Price", "default": "$49" },
      { "type": "text", "id": "compare_price", "label": "Compare-at price (optional)" },
      { "type": "text", "id": "rating", "label": "Rating (optional)", "default": "4.9" },
      { "type": "color", "id": "accent", "label": "Accent", "default": "#3B82F6" },
      { "type": "color", "id": "rim_top", "label": "Rim highlight", "default": "#8FD9FF" },
      { "type": "image_picker", "id": "image", "label": "Product image (else premium placeholder)" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop" },
      { "type": "url", "id": "button_url", "label": "Link" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "home", "settings": {
        "eyebrow": "THE LINEUP", "heading": "Shop ", "heading_accent": "HYDRIX.",
        "descriptor": "Clinically dosed. Naturally flavored. Engineered for high performers.",
        "columns": "4", "button_label": "Shop"
      },
      "blocks": [
        { "type": "product", "settings": { "badge": "Bestseller", "title": "DAILY", "flavor": "Glacier Citrus", "price": "$49", "rating": "4.9", "accent": "#3B82F6", "rim_top": "#8FD9FF", "button_label": "Shop", "button_url": "/pages/product-daily" } },
        { "type": "product", "settings": { "badge": "New", "title": "FOCUS", "flavor": "Yuzu Mint", "price": "$49", "rating": "4.8", "accent": "#22D37D", "rim_top": "#7DFFC2", "button_label": "Shop", "button_url": "#" } },
        { "type": "product", "settings": { "title": "ACTIVE", "flavor": "Blood Orange", "price": "$49", "rating": "4.8", "accent": "#FF6B1A", "rim_top": "#FFBC66", "button_label": "Shop", "button_url": "#" } },
        { "type": "product", "settings": { "title": "RECOVER", "flavor": "Wild Berry", "price": "$49", "rating": "4.9", "accent": "#8E9BFF", "rim_top": "#CFA4FF", "button_label": "Shop", "button_url": "#" } }
      ]
    }
  ]
}
{% endschema %}
