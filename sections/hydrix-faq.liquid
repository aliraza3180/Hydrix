{%- comment -%} HYDRIX — FAQ accordion (native details/summary, single-column) {%- endcomment -%}
{{ 'hydrix.css' | asset_url | stylesheet_tag }}

{%- liquid assign s = section.settings -%}

<section class="hx-section hx-faqsec" style="
  --hx-bg: {{ s.bg }};
  --hx-heading: {{ s.heading_color }};
  --hx-body: {{ s.body_color }};
  --hx-accent: {{ s.accent }};
  --hx-border: {{ s.border }};
  padding: {{ s.padding }}px 24px;
">
  {% render 'hydrix-bg', settings: section.settings %}
  <div class="hx-wrap--narrow" style="max-width:760px;margin:0 auto">
    {%- if s.heading != blank -%}
      <div class="hx-section-head scroll-trigger animate--fade-in">
        {%- if s.eyebrow != blank -%}<div class="hx-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
        <h2 class="hx-h2">{{ s.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="scroll-trigger animate--slide-in">
      {%- for block in section.blocks -%}
        <details class="hx-faq__item"{% if forloop.first and s.open_first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="hx-faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="hx-faq__toggle">+</span>
          </summary>
          <div class="hx-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .hx-section-head { margin-bottom: 44px; }
  #shopify-section-{{ section.id }} details.hx-faq__item[open] .hx-faq__toggle { font-size: 0; }
  #shopify-section-{{ section.id }} details.hx-faq__item[open] .hx-faq__toggle::after { content: '–'; font-size: 24px; }
{% endstyle %}

{% schema %}
{
  "name": "HYDRIX FAQ",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "select", "id": "bg_position", "label": "Background position", "options": [ { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "color", "id": "bg_overlay", "label": "Overlay color", "default": "#0A0B0F" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 70 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "checkbox", "id": "open_first", "label": "Open first item", "default": true },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0A0B0F" },
    { "type": "color", "id": "heading_color", "label": "Heading / question", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Answer", "default": "#6C7685" },
    { "type": "color", "id": "accent", "label": "Toggle accent", "default": "#2D6BFF" },
    { "type": "color", "id": "border", "label": "Dividers", "default": "#20242A" }
  ],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What is HYDRIX?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "HYDRIX is a full-spectrum hydration system — 7 essential electrolytes, trace minerals, and absorption support. Zero sugar, naturally flavored." }
    ]}
  ],
  "presets": [{ "name": "HYDRIX FAQ", "blocks": [
    { "type": "qa", "settings": { "question": "What is HYDRIX?", "answer": "HYDRIX is a full-spectrum hydration system — 7 essential electrolytes, trace minerals, and absorption support engineered to replenish what your body actually loses. Zero sugar, naturally flavored." } },
    { "type": "qa", "settings": { "question": "When do you launch?", "answer": "We're finalizing production now. Waitlist members and Founders are notified first — Founders get access before the public list." } },
    { "type": "qa", "settings": { "question": "Is it really zero sugar?", "answer": "Yes — 0g sugar, no artificial junk, no compromise. Naturally flavored Glacier Citrus." } },
    { "type": "qa", "settings": { "question": "Will I get spammed?", "answer": "Never. We send launch news and early-access perks only. Unsubscribe anytime." } }
  ]}]
}
{% endschema %}
